    "maintenance.execute.uncertain.detail": {
      "comment": "Task 6b (A2): a transport timeout during execute, not a decoded reply — the server may have gone all the way (plan_id consumed, audit line written, update actually done) even though the client gave up waiting. Points at the History section already on this tab, which carries the real answer.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The transport timed out during execution. The server may have finished the action anyway — check the history below."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le délai de transport a été dépassé pendant l'exécution. Le serveur a peut-être quand même terminé l'action — consultez l'historique ci-dessous."
