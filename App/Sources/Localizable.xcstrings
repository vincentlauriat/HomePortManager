    "The control center reads your fleet from this file. Declare a first machine and it shows up here, with its own colour.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The control center reads your fleet from this file. Declare a first machine and it shows up here, with its own colour."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le centre de contrôle lit votre flotte dans ce fichier. Déclarez une première machine et elle apparaît ici, avec sa propre couleur."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "控制中心从此文件读取你的机群。声明第一台机器后，它就会带着自己的颜色出现在这里。"
          }
        }
      }
    },
    "The embedded terminal arrives in a later epic.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The embedded terminal arrives in a later epic."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le terminal intégré arrive dans un epic ultérieur."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "内嵌终端将在后续 epic 中提供。"
          }
        }
      }
    },
    "The event stream arrives with the Homeport API, in a later epic.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The event stream arrives with the Homeport API, in a later epic."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le flux d'événements arrive avec l'API Homeport, dans un epic ultérieur."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "事件流将随 Homeport API 在后续 epic 中提供。"
          }
        }
      }
    },
    "The machine's Homeport dashboard is embedded here by story 1.4.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The machine's Homeport dashboard is embedded here by story 1.4."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le tableau de bord Homeport de la machine s'intègre ici avec la story 1.4."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该机器的 Homeport 仪表盘将由 story 1.4 嵌入此处。"
          }
        }
      }
    },
    "The most recent local backup replaces the current config and data of %@.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The most recent local backup replaces the current config and data of %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La sauvegarde locale la plus récente remplace la configuration et les données actuelles de %@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最近的本地备份将替换 %@ 当前的配置和数据。"
          }
        }
      }
    },
    "The task journal could not be opened — actions still run normally, they just leave no trace here. Check the file below, then relaunch the app.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The task journal could not be opened — actions still run normally, they just leave no trace here. Check the file below, then relaunch the app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le journal des tâches n'a pas pu être ouvert — les actions s'exécutent normalement, elles ne laissent simplement aucune trace ici. Vérifiez le fichier ci-dessous, puis relancez l'application."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法打开任务日志——操作仍会正常执行，只是不会在此留下任何记录。请检查下方文件，然后重新启动应用程序。"
          }
        }
      }
    },
