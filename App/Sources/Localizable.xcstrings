{
  "sourceLanguage": "en",
  "strings": {
    "%@ finished": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ finished"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Action terminée : %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已完成"
          }
        }
      }
    },
    "%@ is unreachable. Check Tailscale or retry.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is unreachable. Check Tailscale or retry."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ est injoignable. Vérifiez Tailscale ou réessayez."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法访问 %@。请检查 Tailscale 或重试。"
          }
        }
      }
    },
    "%@ — %@ — %@": {
      "comment": "Body of the critical-event notification (story 2.2b): subject, kind, detail (machine content, never translated) — dash-separated, so the format stays identical across languages.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — %@ — %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — %@ — %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — %@ — %@"
          }
        }
      }
    },
    "%@: %@ failed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: %@ failed"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ : échec de %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@：%@ 失败"
          }
        }
      }
    },
    "%@: critical event": {
      "comment": "Title of the macOS notification for a critical event (story 2.2b). %@ is the machine name.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: critical event"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ : événement critique"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@：严重事件"
          }
        }
      }
    },
    "A backup of %@ is taken first, then %@ is installed and its service restarts.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A backup of %1$@ is taken first, then %2$@ is installed and its service restarts."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une sauvegarde de %1$@ est d'abord effectuée, puis la version %2$@ est installée et son service redémarre."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先对 %1$@ 进行备份，然后安装 %2$@ 并重启其服务。"
          }
        }
      }
    },
    "A backup of %@ is taken first, then the latest release is installed and its service restarts.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A backup of %@ is taken first, then the latest release is installed and its service restarts."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une sauvegarde de %@ est d'abord effectuée, puis la dernière version est installée et son service redémarre."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先对 %@ 进行备份，然后安装最新版本并重启其服务。"
          }
        }
      }
    },
