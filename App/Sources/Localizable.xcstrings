    "Every action started from this Mac — from the app or from the hpm command line — is recorded here once it runs.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every action started from this Mac — from the app or from the hpm command line — is recorded here once it runs."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque action lancée depuis ce Mac — depuis l'app ou la ligne de commande hpm — est consignée ici dès qu'elle s'exécute."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从这台 Mac 发起的每个操作——无论来自应用还是 hpm 命令行——都会在执行后记录在此。"
          }
        }
      }
    },
